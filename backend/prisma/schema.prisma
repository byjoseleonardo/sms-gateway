generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SmsMessageStatus {
  QUEUED
  CLAIMED
  SENT
  DELIVERED
  FAILED
  AMBIGUOUS
}

model Gateway {
  gatewayId      String       @id @map("gateway_id") @db.VarChar(64)
  tokenHash             String       @map("token_hash") @db.VarChar(64)
  pendingTokenHash      String?      @map("pending_token_hash") @db.VarChar(64)
  pendingTokenExpiresAt DateTime?    @map("pending_token_expires_at")
  tokenRotatedAt        DateTime?    @map("token_rotated_at")
  deviceId              String       @map("device_id") @db.VarChar(128)
  deviceModel    String       @map("device_model") @db.VarChar(128)
  androidVersion String       @map("android_version") @db.VarChar(64)
  appVersion     String       @map("app_version") @db.VarChar(64)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  lastSeenAt     DateTime?    @map("last_seen_at")
  messages       SmsMessage[]
  auditLogs      OperatorAuditLog[]

  @@index([lastSeenAt])
  @@map("gateways")
}

model SmsMessage {
  id             String           @id @db.VarChar(64)
  idempotencyKey String           @unique @map("idempotency_key") @db.VarChar(128)
  gatewayId      String           @map("gateway_id") @db.VarChar(64)
  destination    String           @db.VarChar(32)
  message        String           @db.VarChar(160)
  status         SmsMessageStatus @default(QUEUED)
  attempts       Int              @default(0)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  claimedAt      DateTime?        @map("claimed_at")
  sentAt         DateTime?        @map("sent_at")
  deliveredAt    DateTime?        @map("delivered_at")
  lastError              String?          @map("last_error") @db.VarChar(500)
  operatorResolvedAt     DateTime?        @map("operator_resolved_at")
  operatorResolutionNote String?          @map("operator_resolution_note") @db.VarChar(500)
  gateway                Gateway          @relation(fields: [gatewayId], references: [gatewayId], onDelete: Restrict)

  @@index([gatewayId, status, createdAt])
  @@map("sms_messages")
}


model OperatorAuditLog {
  id        String   @id @db.VarChar(64)
  action    String   @db.VarChar(64)
  targetId  String   @map("target_id") @db.VarChar(128)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  gatewayId String?  @map("gateway_id") @db.VarChar(64)
  gateway   Gateway? @relation(fields: [gatewayId], references: [gatewayId], onDelete: SetNull)

  @@index([createdAt])
  @@index([gatewayId, createdAt])
  @@map("operator_audit_logs")
}
