{
  "name": "sms-gateway-backend",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "db:import-json": "tsx scripts/import-json.ts",
    "secrets:rotate": "tsx scripts/rotate-local-secrets.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/messages/SmsMessageRegistry.test.js dist/clients/ApiClientRegistry.test.js dist/clients/ClientApi.test.js dist/gateways/GatewayRouting.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
